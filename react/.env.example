# Copy to .env.local and fill in. Both values end up in the browser bundle:
# only ever put the PUBLIC key here, never the secret one.

# Storefront API base, including /storefront/v1.
VITE_UNIPAGE_API_URL=https://api.unipage.eu/storefront/v1

# Your public key (upg_sf_pk_...), issued by Unipage for your registered origins.
VITE_UNIPAGE_PUBLIC_KEY=upg_sf_pk_replace-me

# The /api proxy target (the Node relay) is NOT read from this file: vite.config.js
# takes it from the shell, `BFF_URL=http://localhost:8787 npm run dev` (that is the default).
