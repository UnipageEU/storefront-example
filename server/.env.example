# Copy to .env and fill in. This file stays on the server: never commit .env
# and never ship the secret key to the browser.

# Storefront API base, including /storefront/v1.
UNIPAGE_API_URL=https://api.unipage.eu/storefront/v1

# Your secret key (upg_sf_sk_...), from the same storefront as the public key.
UNIPAGE_SECRET_KEY=upg_sf_sk_replace-me

# The storefront's origin: the shopper returns to ${PUBLIC_URL}/order/{orderId}.
PUBLIC_URL=http://localhost:5173

# Optional: signing secret of the order webhooks (whsec_...).
# UNIPAGE_WEBHOOK_SECRET=

# Optional: let the storefront send its own customer messages.
# CUSTOMER_NOTIFICATIONS=false
